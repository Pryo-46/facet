{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"],
    "noEmit": true,
    "composite": true
  },
  /* app 側の exclude（テストファイル）を継承すると include が全部落ちるので打ち消す */
  "exclude": [],
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src"]
}
