# Skill の評価ワークスペース（実行結果。evals/ から再生成できる）
skill-eval-workspace/

node_modules/

# ビルド成果物
dist/
dist-ssr/
*.local

# Tauri（Rust 側のビルド成果物）
src-tauri/target/
src-tauri/gen/

# スキーマから生成する型（正は schemas/*.schema.json。npm run gen:types で再生成）
src/types/*.ts

# ログ
logs
*.log
npm-debug.log*

# エディタ
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# 開発時の一時ファイル
docs/screenshots/

# 作業ツリー（EnterWorktree が作る。中身はリポジトリの複製なので、
# 無視しないと誤ってツリー全体をコミットしうる）。.claude/skills/ は追跡対象
.claude/worktrees/

# 実装計画の実行ワークスペース（ブリーフ・レポート・レビューパッケージ。
# 記録は git 履歴側に残るため再生成不要）
.superpowers/